secrets.toml
*.secret
*.pem
*.key

# Local operator overrides (may name private paths)
config/local.toml
config/*.local.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp
