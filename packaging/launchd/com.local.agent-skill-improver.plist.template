<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the daily pass. PRINTED, NEVER INSTALLED.

  The scheduler-template command fills in the repository path, the interpreter,
  the config file it was invoked with and that config's state directory, then
  writes the result to stdout. Nothing is scheduled until you copy it into
  your own LaunchAgents directory and run launchctl yourself. Read
  docs/SCHEDULING.md first, in particular the part about what this job may and
  may not do.

  What this job runs: the daily driver in commit mode. That ingests, scores,
  isolates, proposes and validates, and writes only under the configured state
  directory. It can never modify a skill file: the driver refuses a writable
  skill store, it does not import the promotion module at all, and it hashes the
  skill tree before and after so a mutation from any source is visible in the
  receipt.

  Promotion is deliberately absent from this file. EnvironmentVariables sets the
  automation marker for this whole job, so an apply step added to it refuses.
  A separate job without the marker can still run apply with a token and
  acknowledgement: apply does not authenticate its caller. Do not schedule apply.

  Note on XML: comments in a property list may not contain a double hyphen, so
  flags are named in prose here rather than typed literally.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.agent-skill-improver</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ASI_AUTOMATED_RUN</key>
    <string>1</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>agent_skill_improver</string>
    <string>--config</string>
    <string>__CONFIG__</string>
    <string>daily</string>
    <string>--commit</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Once a day. StartCalendarInterval fires on a wall clock match, so a run
       missed while the machine was asleep is simply skipped rather than queued.
       That is the safer default here: the loop is idempotent per UTC day, so the
       next day's run picks up where this one left off, and deferred records are
       retried by design. Whether the job actually fired is a question for
       asi doctor, whose last run line gives the newest receipt's age and warns
       once it is more than two whole days old. Exit status 5 means the skill
       tree changed while the run was reading it; every committed run after that
       exits 5 again, before taking the lock, until one committed run is started
       with the mutation-reviewed flag naming the blocked run's day (a dry run
       writes no receipt, so it neither blocks nor clears). This file needs no
       change. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>17</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- Both streams go to the configured state tree. They can contain excerpts of
       private conversation content, so treat them exactly like state/raw/; the
       next daily run resets their mode to owner-only. -->
  <key>StandardOutPath</key>
  <string>__STATE__/daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/daily.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
